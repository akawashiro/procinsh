[Unit]
Description=ProcInSh main preview
ConditionPathExists=%h/procinsh-main-preview/procinsh
StartLimitIntervalSec=0

[Service]
Type=exec
ExecStart=%h/procinsh-main-preview/procinsh --listen 0.0.0.0:9090 --allow-non-loopback
Restart=on-failure
RestartSec=3s
TimeoutStopSec=30s

[Install]
WantedBy=default.target
