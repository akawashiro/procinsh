{
  "$schema": "https://typedoc.org/schema.json",
  "name": "ProcInSh TypeScript API",
  "entryPoints": [
    "src"
  ],
  "entryPointStrategy": "expand",
  "exclude": [
    "tests/**"
  ],
  "excludeExternals": true,
  "tsconfig": "tsconfig.json",
  "out": "../target/doc/typescript",
  "readme": "none",
  "navigationLinks": {
    "All API documentation": "https://akawashiro.github.io/procinsh/",
    "Rust architecture": "https://akawashiro.github.io/procinsh/architecture/"
  },
  "treatWarningsAsErrors": true
}
