[Unit]
Description=ProcInSh main preview
ConditionPathExists=%h/procinsh-main-preview/procinsh
StartLimitIntervalSec=0

[Service]
Type=exec
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/bin/bash %h/procinsh-main-preview/preview_bind.sh run %h/procinsh-main-preview/procinsh 9090
Restart=on-failure
RestartSec=3s
TimeoutStopSec=30s

[Install]
WantedBy=default.target
