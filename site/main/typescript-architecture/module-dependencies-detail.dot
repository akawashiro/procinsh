    "shared/api.ts" [label="api.ts", tooltip="shared/api.ts"];
    "shared/display.ts" [label="display.ts", tooltip="shared/display.ts"];
    "shared/dom.ts" [label="dom.ts", tooltip="shared/dom.ts"];
    "shared/hosts.ts" [label="hosts.ts", tooltip="shared/hosts.ts"];
    "shared/navigation.ts" [label="navigation.ts", tooltip="shared/navigation.ts"];
  }
