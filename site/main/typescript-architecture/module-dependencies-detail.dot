digraph {
  graph [rankdir=LR, bgcolor="white", pad=0.3];
  node [shape=box, style="rounded,filled", fillcolor="#e8f2ff", fontname="sans-serif"];
  edge [color="#475569", arrowsize=0.8];
  subgraph "cluster_list" {
    graph [label="list", fontname="sans-serif", color="#94a3b8", style="rounded", margin=16, labeljust=l];
    "list/app.ts" [label="app.ts", tooltip="list/app.ts"];
    "list/data.ts" [label="data.ts", tooltip="list/data.ts"];
    "list/dom-types.ts" [label="dom-types.ts", tooltip="list/dom-types.ts"];
    "list/renderer.ts" [label="renderer.ts", tooltip="list/renderer.ts"];
    "list/search.ts" [label="search.ts", tooltip="list/search.ts"];
  }
  subgraph "cluster_process" {
    graph [label="process", fontname="sans-serif", color="#94a3b8", style="rounded", margin=16, labeljust=l];
    "process/app.ts" [label="app.ts", tooltip="process/app.ts"];
    "process/architecture.ts" [label="architecture.ts", tooltip="process/architecture.ts"];
    "process/data.ts" [label="data.ts", tooltip="process/data.ts"];
