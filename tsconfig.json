{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "legacy",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["@webgpu/types"],
    "strict": true,
    "noEmitOnError": true,
    "rootDir": "src/web",
    "outDir": "dist/web",
    "paths": {
      "/vendor/three.module.js": ["./node_modules/@types/three/index.d.ts"],
      "/vendor/OrbitControls.js": [
        "./node_modules/@types/three/examples/jsm/controls/OrbitControls.d.ts"
      ],
      "/space-model.js": ["./src/web/space-model.ts"]
    }
  },
  "include": ["src/web/**/*.ts"],
  "exclude": ["src/web/vendor"]
}
